# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB ---
# Local:  mongodb://127.0.0.1:27017/wishlist
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/wishlist?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/wishlist

# Only needed if Node cannot run SRV lookups on this network (mongodb+srv:// fails
# with "querySrv ECONNREFUSED" even though the cluster hostname resolves elsewhere).
DNS_SERVERS=

# --- Google OAuth ---
# Create at https://console.cloud.google.com/apis/credentials
# OAuth client type: "Web application"
# Authorized JavaScript origins: http://localhost:5173
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Auth session ---
# Any long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Set to "none" (plus HTTPS) only when the API and the web app live on different domains
COOKIE_SAMESITE=lax
