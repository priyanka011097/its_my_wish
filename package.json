{
  "name": "wishlist",
  "version": "1.0.0",
  "private": true,
  "description": "Custom wishlist boards - share wishes as photos, links or notes",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "test": "npm --prefix server test",
    "db": "npm --prefix server run db",
    "dev:all": "concurrently -n db,api,web -c green,magenta,cyan \"npm:db\" \"npm:dev:api\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
